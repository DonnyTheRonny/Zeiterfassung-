{
  "name": "stempelkarte",
  "version": "1.0.0",
  "description": "Petrus Zeiterfassung",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:html": "node build-html.js",
    "dist": "electron-builder --win portable --x64"
  },
  "keywords": [],
  "author": "Petrus Zeiterfassung",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "xlsx": "0.18.5"
  },
  "dependencies": {},
  "build": {
    "appId": "de.stempelkarte.app",
    "productName": "Petrus Zeiterfassung",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Petrus-Zeiterfassung.exe"
    }
  }
}